# Copy this to .env (same folder as docker-compose.yml) and fill in your values.
# .env is gitignored -- don't commit your real API key.

# Host path to your audiobook library (the actual path on blender/Unraid,
# e.g. /mnt/user/media/audiobooks). Mounted into the container at /audiobooks.
AUDIOBOOKS_PATH=/mnt/user/media/audiobooks

# Bindery's API base, from wherever this container can reach it.
# If Bindery is a container on the same Unraid box's default bridge network,
# blender's LAN IP or hostname (not "localhost") is usually the safe bet:
BINDERY_URL=http://blender:8787/api/v1

# Settings -> API in the Bindery UI.
BINDERY_API_KEY=
